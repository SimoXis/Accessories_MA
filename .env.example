# Development (SQLite if DATABASE_URL is empty)
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL (recommended even locally)
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/accesories_ma
# DATABASE_SSL_REQUIRE=false

# Production (PostgreSQL required — use demo.settings.production / gunicorn)
# DEBUG=False
# SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# ALLOWED_HOSTS=www.example.com,example.com
# CSRF_TRUSTED_ORIGINS=https://www.example.com,https://example.com
# DATABASE_SSL_REQUIRE=true
# SECURE_SSL_REDIRECT=true

# Alternative to DATABASE_URL:
# DB_NAME=accesories_ma
# DB_USER=app_user
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
